generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scenario {
  id               String   @id
  name             String   @default("Default")
  constructionCost Int      @default(10000000)
  equipmentCost    Int      @default(4000000)
  jobsPerMonth     Int      @default(200)
  pricePerJob      Int      @default(25000)
  cogsPercent      Int      @default(70)
  staffCost        Int      @default(430000)
  rent             Int      @default(70000)
  paintCost        Int      @default(300000)
  utilities        Int      @default(120000)
  misc             Int      @default(100000)
  software         Int      @default(30000)
  capacityPercent  Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model LineRegistration {
  id            Int       @id @default(autoincrement())
  lineUserId    String    @unique @map("line_user_id") @db.VarChar(50)
  displayName   String?   @map("display_name") @db.VarChar(255)
  pictureUrl    String?   @map("picture_url") @db.Text
  statusMessage String?   @map("status_message") @db.VarChar(255)
  system        String    @default("EV7") @map("system") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  role          String    @default("USER") @map("role") @db.VarChar(20)
  registeredAt  DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("line_registrations")
}

model LineGroup {
  id            Int      @id @default(autoincrement())
  groupId       String   @unique @map("group_id") @db.VarChar(50)
  groupName     String?  @map("group_name") @db.VarChar(255)
  groupType     String   @default("group") @map("group_type") @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  enableReport  Boolean  @default(false) @map("enable_report")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("line_groups")
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  sourceType  String   @map("source_type") @db.VarChar(20)
  sourceId    String?  @map("source_id") @db.VarChar(50)
  userName    String?  @map("user_name") @db.VarChar(255)
  userMessage String   @map("user_message") @db.Text
  botReply    String   @map("bot_reply") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("chat_logs")
}

model ActivityNotification {
  id         Int      @id @default(autoincrement())
  recordType String   @map("record_type") @db.VarChar(30)  // 'MAINTENANCE' | 'DELIVERY'
  recordId   Int      @map("record_id")
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@unique([recordType, recordId])
  @@map("activity_notifications")
}

model SystemIssue {
  id          Int       @id @default(autoincrement())
  lineUserId  String?   @map("line_user_id") @db.VarChar(50)
  displayName String?   @map("display_name") @db.VarChar(255)
  description String    @map("description") @db.Text
  status      String    @default("OPEN") @map("status") @db.VarChar(20) // 'OPEN' | 'RESOLVED' | 'CANCELLED'
  sourceType  String?   @map("source_type") @db.VarChar(20)  // 'user' | 'group' | 'room'
  sourceId    String?   @map("source_id") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz

  @@map("system_issues")
}
