generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scenario {
  id               String   @id
  name             String   @default("Default")
  constructionCost Int      @default(10000000)
  equipmentCost    Int      @default(4000000)
  jobsPerMonth     Int      @default(200)
  pricePerJob      Int      @default(25000)
  cogsPercent      Int      @default(70)
  staffCost        Int      @default(430000)
  rent             Int      @default(70000)
  paintCost        Int      @default(300000)
  utilities        Int      @default(120000)
  misc             Int      @default(100000)
  software         Int      @default(30000)
  capacityPercent  Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model LineRegistration {
  id            Int       @id @default(autoincrement())
  lineUserId    String    @unique @map("line_user_id") @db.VarChar(50)
  displayName   String?   @map("display_name") @db.VarChar(255)
  pictureUrl    String?   @map("picture_url") @db.Text
  statusMessage String?   @map("status_message") @db.VarChar(255)
  system        String    @default("EV7") @map("system") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  role          String    @default("USER") @map("role") @db.VarChar(20)
  ev7UserId     Int?      @map("ev7_user_id")
  registeredAt  DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("line_registrations")
}

model LineGroup {
  id              Int      @id @default(autoincrement())
  groupId         String   @unique @map("group_id") @db.VarChar(50)
  groupName       String?  @map("group_name") @db.VarChar(255)
  groupType       String   @default("group") @map("group_type") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  enableReport    Boolean  @default(false) @map("enable_report")
  enableClaimLog  Boolean  @default(false) @map("enable_claim_log")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("line_groups")
}

model ClaimLog {
  id              Int      @id @default(autoincrement())
  vehicleRef      String?  @map("vehicle_ref") @db.VarChar(50)
  lineUserId      String?  @map("line_user_id") @db.VarChar(50)
  displayName     String?  @map("display_name") @db.VarChar(255)
  message         String   @map("message") @db.Text
  extractedDetail String?  @map("extracted_detail") @db.Text
  status          String   @default("PENDING") @map("status") @db.VarChar(20) // 'PENDING' | 'PROCESSED' | 'CANCELLED'
  groupId         String?  @map("group_id") @db.VarChar(50)
  location        String?  @map("location") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("claim_logs")
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  sourceType  String   @map("source_type") @db.VarChar(20)
  sourceId    String?  @map("source_id") @db.VarChar(50)
  userName    String?  @map("user_name") @db.VarChar(255)
  userMessage String   @map("user_message") @db.Text
  botReply    String   @map("bot_reply") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("chat_logs")
}

model ActivityNotification {
  id         Int      @id @default(autoincrement())
  recordType String   @map("record_type") @db.VarChar(30)  // 'MAINTENANCE' | 'DELIVERY'
  recordId   Int      @map("record_id")
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@unique([recordType, recordId])
  @@map("activity_notifications")
}

model SystemIssue {
  id          Int       @id @default(autoincrement())
  lineUserId  String?   @map("line_user_id") @db.VarChar(50)
  displayName String?   @map("display_name") @db.VarChar(255)
  description String    @map("description") @db.Text
  status      String    @default("OPEN") @map("status") @db.VarChar(20) // 'OPEN' | 'RESOLVED' | 'CANCELLED'
  sourceType  String?   @map("source_type") @db.VarChar(20)  // 'user' | 'group' | 'room'
  sourceId    String?   @map("source_id") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz

  @@map("system_issues")
}

model TaskNote {
  id                 Int       @id @default(autoincrement())
  vehicleRef         String?   @map("vehicle_ref") @db.VarChar(50)
  assigneeName       String    @default("ยังไม่ทราบผู้รับผิดชอบ") @map("assignee_name") @db.VarChar(255)
  taskDetail         String    @map("task_detail") @db.Text
  dueDate            DateTime? @map("due_date") @db.Date
  status             String    @default("PENDING") @map("status") @db.VarChar(20)
  createUserId       String?   @map("create_user_id") @db.VarChar(50)
  createUserName     String?   @map("create_user_name") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  alertTarget        String    @default("NONE") @map("alert_target") @db.VarChar(20)
  groupId            String?   @map("group_id") @db.VarChar(50)
  assigneeLineUserId String?   @map("assignee_line_user_id") @db.VarChar(50)
  lastAlertedAt      DateTime? @map("last_alerted_at") @db.Timestamptz

  @@map("task_notes")
}
